	"description": "Sohedra UI monorepo: accessible, headless Svelte components",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sohedra/ui.git"
	},
	"type": "module",
	"scripts": {
		"lint": "oxlint --no-error-on-unmatched-pattern",
